# Copy to .env (never commit .env). All settings are read by backend/app/core/config.py.

# Embeddings: voyage-4-large (1024 dims). Get a key at https://dash.voyageai.com/
RAG_VOYAGE_API_KEY=
RAG_EMBEDDING_MODEL=voyage-4-large
RAG_EMBEDDING_DIM=1024
# Free tier (no payment method on the Voyage account): 3 requests and 10,000 tokens per minute.
# The first 200M tokens are free either way; raise these only after adding a payment method.
RAG_EMBEDDING_REQUESTS_PER_MINUTE=3
RAG_EMBEDDING_TOKENS_PER_MINUTE=10000
# Offline development without a key (vectors are NOT semantic):
# RAG_EMBEDDING_MODEL=local-hash

# Database (docker compose up -d db exposes it on 5433)
POSTGRES_PASSWORD=rag
RAG_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag
